{
  "name": "project-management-control-app",
  "version": "3.0.0",
  "description": "Project Management Control App",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "vite build && electron-builder build --win",
    "build:react": "vite build"
  },
  "build": {
    "appId": "com.project.management",
    "productName": "Project Management App",
    "win": {
      "target": "nsis",
      "icon": "icon-512.png"
    },
    "files": [
      "main.js",
      "package.json",
      "dist/**/*",
      "icon.ico",
      "icon-192.png",
      "icon-512.png",
      "manifest.json"
    ],
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": true
    }
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "firebase": "^10.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
